# Claude API key - optional. Without it, recommendations fall back to rule-based summaries.
ANTHROPIC_API_KEY=
SEO_AI_MODEL=claude-opus-5-5
SEO_AI_EFFORT=medium

# Optional: Google PageSpeed Insights API key (free) for Lighthouse / Core Web Vitals
SEO_PAGESPEED_API_KEY=

# Crawl limits
SEO_DEFAULT_MAX_PAGES=50
SEO_MAX_PAGES_LIMIT=500
SEO_CONCURRENCY=4
SEO_DELAY_BETWEEN_REQUESTS_S=0.25

# Security
# If set, clients must send X-API-Key
SEO_API_KEY=
SEO_RATE_LIMIT_PER_MINUTE=10
SEO_CORS_ORIGINS=http://localhost:3000
# Never true in production (SSRF protection)
SEO_ALLOW_PRIVATE_NETWORKS=false
