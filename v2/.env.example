# Copy to .env and fill in. Only ANTHROPIC_API_KEY is needed for AI recommendations.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_EFFORT=medium            # low | medium | high — higher = deeper advice, more tokens

# Optional: Google PageSpeed Insights key (free) for higher quota on Core Web Vitals data
PAGESPEED_API_KEY=

# Crawl politeness / limits
# DEFAULT_MAX_PAGES=50
# HARD_MAX_PAGES=500
# REQUEST_DELAY_SECONDS=0.5
# CRAWL_CONCURRENCY=4
# MAX_CONCURRENT_AUDITS=2

# Never enable in production: lets the crawler reach localhost/private networks (SSRF).
# ALLOW_PRIVATE_TARGETS=false
POSTGRES_PASSWORD=change_me
